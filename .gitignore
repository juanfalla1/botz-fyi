# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Office temp/lock files
~$*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.tsc_webhook_check*.log

# Local research, personal files, and generated demo output
/.firecrawl/
/GRM/
/juan personal/
/artifacts/
/demo-output/
**/__pycache__/

# Local n8n demo tooling may contain temporary credentials
/app/api/n8n/scripts/

.aider*
